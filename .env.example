# ---------------------------------------------------------------------------
# MYO'S AI consultant — server-only settings. Copy to .env.local for development.
# None of these are NEXT_PUBLIC_, so none of them ever reach the browser.
# ---------------------------------------------------------------------------

# Google Gemini (https://aistudio.google.com/apikey). Without a key the consultant
# runs in its deterministic "simplified mode" and says so.
GEMINI_API_KEY=
# An alias that tracks the current Flash model, or pin a specific model id in production.
GEMINI_MODEL=gemini-flash-latest
# Optional: a separate (cheaper/faster) model for the relevance classifier.
# GEMINI_CLASSIFIER_MODEL=
# Optional: override the API base URL (egress proxy, or a local mock for testing).
# GEMINI_API_BASE_URL=
# GEMINI_TIMEOUT_MS=25000
# GEMINI_GENERATION_TIMEOUT_MS=40000
# GEMINI_MAX_RETRIES=2
# GEMINI_MAX_OUTPUT_TOKENS=4096
# CONSULTANT_STREAMING=true

# Persistence. In production use Upstash Redis (Vercel Marketplace → Upstash for Redis
# injects KV_REST_API_URL / KV_REST_API_TOKEN, which are also accepted).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# redis | file | memory. Default: redis when credentials exist, else file in
# development and memory (not durable!) in production.
# CONSULTATION_STORE=
# CONSULTATION_FILE_STORE_DIR=.data/consultations
# CONSULTATION_TTL_DAYS=90

# Abuse limits.
# CONSULTANT_MESSAGES_PER_MINUTE=12
# CONSULTANT_MESSAGES_PER_DAY=200
# CONSULTANT_IP_REQUESTS_PER_MINUTE=60
# CONSULTANT_MAX_TURNS=60
