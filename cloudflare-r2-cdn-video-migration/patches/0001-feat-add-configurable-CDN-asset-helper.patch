@@ -0,0 +1,29 @@
+/**
+ * Public asset resolution. Large media (videos, heavy posters) lives in Cloudflare R2 and is
+ * served through the Cloudflare CDN, not out of `public/`. Everything here is public information:
+ * R2 write credentials stay on the backend and must never reach a `NEXT_PUBLIC_*` variable.
+ *
+ * When `NEXT_PUBLIC_CDN_BASE_URL` is unset the path is returned unchanged, so a local checkout
+ * without CDN configuration still resolves against `public/`.
+ */
+
+const CDN_BASE_URL = process.env.NEXT_PUBLIC_CDN_BASE_URL?.replace(/\/+$/, "") ?? ""
+
+export function cdn(path: string): string {
+  const normalizedPath = path.startsWith("/") ? path : `/${path}`
+
+  if (!CDN_BASE_URL) return normalizedPath
+
+  return `${CDN_BASE_URL}${normalizedPath}`
+}
+
+/**
+ * Canonical object keys for the permanent site videos. Named here so the three components that
+ * embed them cannot drift apart, and so a re-encode only has to be versioned in one place
+ * (`rehab.mp4` → `rehab-v2.mp4`) to bust the CDN edge cache.
+ */
+export const videoAssets = {
+  rehab: cdn("/videos/rehab.mp4"),
+  educationDemo: cdn("/videos/education-demo.mp4"),
+  governmentDemo: cdn("/videos/government-demo.mp4"),
+} as const
