index 0000000..77d9b9b
--- /dev/null
+++ b/scripts/migrate-videos-to-r2.sh
@@ -0,0 +1,133 @@
+#!/usr/bin/env bash
+#
+# One-time migration of the permanent site videos into Cloudflare R2.
+#
+# These three files are site assets with stable names — they do not go through the CMS upload
+# endpoint, which mints dated `uploads/videos/...` keys. Run this once, verify the public URLs,
+# and only then remove the local copies.
+#
+# Requires the AWS CLI v2 (R2 is S3-compatible).
+#
+#   R2_ACCOUNT_ID=...          Cloudflare account id
+#   R2_ACCESS_KEY_ID=...       R2 API token access key (needs Object Read & Write)
+#   R2_SECRET_ACCESS_KEY=...   R2 API token secret
+#   R2_BUCKET=myos-assets      target bucket
+#   CDN_BASE_URL=https://assets.myos.ai   custom domain in front of the bucket
+#
+# Usage:
+#   ./scripts/migrate-videos-to-r2.sh            # upload, then verify
+#   ./scripts/migrate-videos-to-r2.sh --verify   # verify already-uploaded objects only
+
+set -euo pipefail
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+VERIFY_ONLY=false
+[[ "${1:-}" == "--verify" ]] && VERIFY_ONLY=true
+
+require_env() {
+  local name="$1"
+  if [[ -z "${!name:-}" ]]; then
+    echo "error: $name is not set" >&2
+    exit 1
+  fi
+}
+
+require_env R2_BUCKET
+require_env CDN_BASE_URL
+
+if [[ "$VERIFY_ONLY" == false ]]; then
+  require_env R2_ACCOUNT_ID
+  require_env R2_ACCESS_KEY_ID
+  require_env R2_SECRET_ACCESS_KEY
+
+  command -v aws >/dev/null 2>&1 || {
+    echo "error: aws CLI not found — install AWS CLI v2" >&2
+    exit 1
+  }
+fi
+
+ENDPOINT="https://${R2_ACCOUNT_ID:-unset}.r2.cloudflarestorage.com"
+CDN_BASE_URL="${CDN_BASE_URL%/}"
+
+# local path -> object key. Keys are lowercase and namespaced under videos/.
+MIGRATIONS=(
+  "public/Rehab.mp4|videos/rehab.mp4"
+  "public/demos/education-demo.mp4|videos/education-demo.mp4"
+  "public/demos/government-demo.mp4|videos/government-demo.mp4"
+)
+
+upload() {
+  local source="$1" key="$2"
+
+  if [[ ! -f "$REPO_ROOT/$source" ]]; then
+    echo "skip: $source not present locally (already removed?)"
+    return
+  fi
+
+  echo "uploading $source -> s3://$R2_BUCKET/$key"
+
+  # Cache-Control is aggressive because these keys are versioned by rename, never overwritten.
+  AWS_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID" \
+  AWS_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY" \
+  AWS_DEFAULT_REGION=auto \
+  aws s3api put-object \
+    --endpoint-url "$ENDPOINT" \
+    --bucket "$R2_BUCKET" \
+    --key "$key" \
+    --body "$REPO_ROOT/$source" \
+    --content-type "video/mp4" \
+    --cache-control "public, max-age=31536000, immutable" \
+    --checksum-algorithm CRC32 \
+    >/dev/null
+}
+
+verify() {
+  local key="$1"
+  local url="$CDN_BASE_URL/$key"
+  local status
+
+  status="$(curl -s -o /dev/null -w '%{http_code}' -I "$url")"
+  if [[ "$status" != "200" ]]; then
+    echo "FAIL $url -> HTTP $status"
+    return 1
+  fi
+
+  # A seekable video needs byte-range support; the CDN must answer 206 to a ranged request.
+  local range_status
+  range_status="$(curl -s -o /dev/null -w '%{http_code}' -r 0-1023 "$url")"
+  if [[ "$range_status" != "206" ]]; then
+    echo "FAIL $url -> range request returned HTTP $range_status (expected 206)"
+    return 1
+  fi
+
+  local content_type
+  content_type="$(curl -s -o /dev/null -w '%{content_type}' -I "$url")"
+  if [[ "$content_type" != video/mp4* ]]; then
+    echo "FAIL $url -> Content-Type '$content_type' (expected video/mp4)"
+    return 1
+  fi
+
+  echo "OK   $url (200, range 206, $content_type)"
+}
+
+if [[ "$VERIFY_ONLY" == false ]]; then
+  for migration in "${MIGRATIONS[@]}"; do
+    upload "${migration%%|*}" "${migration##*|}"
+  done
+  echo
+fi
+
+echo "verifying public URLs..."
+failed=0
+for migration in "${MIGRATIONS[@]}"; do
+  verify "${migration##*|}" || failed=1
+done
+
+if [[ "$failed" -ne 0 ]]; then
+  echo
+  echo "one or more URLs failed verification — do NOT delete the local videos yet" >&2
+  exit 1
+fi
+
+echo
+echo "all videos verified. Set NEXT_PUBLIC_CDN_BASE_URL=$CDN_BASE_URL and deploy."
